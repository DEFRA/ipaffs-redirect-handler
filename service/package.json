{
  "name": "ipaffs-redirect-handler",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "c8 mocha",
    "test:playwright": "playwright test --config test/playwright/playwright.config.js",
    "test-jenkins": "MOCHA_FILE=./report.xml c8 --reporter=cobertura mocha --reporter mocha-junit-reporter --colors",
    "posttest-jenkins": "c8 --reporter=lcov mocha --reporter mocha-sonarqube-reporter test --reporter-options output=coverage/unit.xml --colors",
    "coverage-html": "c8 --reporter=html mocha",
    "build": "rm -rf public && mkdir -p public && echo \"No static assets. The shared Node pipeline publishes this folder.\" > public/README.txt",
    "start": "node app.js"
  },
  "author": "",
  "license": "",
  "description": "OAuth2 Redirect Handler for Microsoft Identity Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEFRA/ipaffs-redirect-handler"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "c8": "^11.0.0",
    "mocha": "^11.7.5",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-sonarqube-reporter": "^1.0.2"
  }
}
